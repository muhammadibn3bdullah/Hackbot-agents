# Optional configuration for the hackbot starter.
# No real target should be used without written authorization.

# --- Findings webhook (harness -> Discord, one-way) ---
DISCORD_WEBHOOK_URL=

# --- Discord bot bridge (Discord -> Maestro agent -> Discord, two-way) ---
DISCORD_BOT_TOKEN=
# Comma-separated Discord USER IDs allowed to command the bot (required).
ALLOWED_USER_IDS=
# Comma-separated CHANNEL IDs (optional; empty = any channel the bot can see).
ALLOWED_CHANNEL_IDS=
MAESTRO_AGENT=hackbot-lead
AGENT_TIMEOUT=300

# --- Harness / Caido ---
HARNESS_URL=http://127.0.0.1:13337
INGEST_TOKEN=
CAIDO_URL=http://127.0.0.1:8080
TARGET_SCOPE=

# --- Model providers (set in your own environment, never commit real keys) ---
OPENCODE_API_KEY=
